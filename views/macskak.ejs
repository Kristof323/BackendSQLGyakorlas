<!DOCTYPE html>
<html lang="hu">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Macskák</title>
</head>
<body>
  <h1>Macskák</h1>

  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Súly</th>
        <th>Szemszín</th>
        <th>Gazdi ID</th>
        <th>Játék ID</th>
      </tr>
    </thead>

    <tbody>
      <% macskak.forEach(macska => { %>
        <tr>
          <td><%= macska.id %></td>
          <td><%= macska.suly %></td>
          <td><%= macska.szem_szin %></td>
          <td><%= macska.gazdi_id %></td>
          <td>
            <%= macska.jatek_id === null ? 'Nincs' : macska.jatek_id %>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</body>
</html>