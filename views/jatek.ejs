<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>jatek</title>
</head>
<body>
    <h1>Játékok</h1>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Név</th>
            </tr>
        </thead>

        <tbody>
            <% jatek.forEach(item => { %>
                <tr>
                    <td><%= item.id %></td>
                    <td><%= item.nev %></td>
                </tr>
            <% }); %>
        </tbody>
    </table>
</body>
</html>